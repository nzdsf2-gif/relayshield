{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchLogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:239677749008:log-group:/aws/lambda/relayshield-intel-monitor",
        "arn:aws:logs:us-east-1:239677749008:log-group:/aws/lambda/relayshield-intel-monitor:*"
      ]
    },
    {
      "Sid": "LambdaInvokeIntelMonitor",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-1:239677749008:function:relayshield-intel-monitor"
    }
  ]
}
