    },
    {
      "parameters": {
        "operation": "oauthWatchlist",
        "email": "={{ $('Vendor/AI-Tool Request Webhook').item.json.requester_email }}"
      },
      "id": "c4d5e6f7-0009-0009-0009-000000000009",
      "name": "RelayShield - OAuth Watchlist (AI Tool)",
      "type": "n8n-nodes-relayshield.relayShield",
      "typeVersion": 1,
      "position": [
        560,
        480
      ],
      "credentials": {
        "relayShieldApi": {
          "id": "1",
          "name": "RelayShield API"
        }
      },
      "notes": "Same requester-exposure check as the SaaS path — relevant here too, since connecting an AI tool/MCP server typically also involves the requester granting it some form of access."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.relayshield.net/v1/metered/mcp-registry-risk",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ server_url: $('Vendor/AI-Tool Request Webhook').item.json.server_url, package_name: $('Vendor/AI-Tool Request Webhook').item.json.package_name }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "c4d5e6f7-0010-0010-0010-000000000010",
      "name": "RelayShield - MCP Registry Risk (AI Tool)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        720
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "5",
          "name": "RelayShield API Key (Header Auth)"
        }
      },
      "notes": "The AI-tool-specific check: flags known-malicious IOC matches, typosquat domains, and newly-registered domains hosting the MCP server. This is the one check that genuinely differs from the SaaS path, not just a relabeled duplicate — it's why AI-tool requests aren't just routed through the SaaS checks alone."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ai-cond-001",
              "leftValue": "={{ $('RelayShield - Supply Chain Risk (AI Tool)').item.json.data.highest_risk }}",
              "rightValue": "CRITICAL",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ai-cond-002",
              "leftValue": "={{ $('RelayShield - Supply Chain Risk (AI Tool)').item.json.data.highest_risk }}",
              "rightValue": "HIGH",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ai-cond-003",
              "leftValue": "={{ $('RelayShield - Secret Scan (AI Tool)').item.json.data.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "ai-cond-004",
              "leftValue": "={{ $('RelayShield - OAuth Watchlist (AI Tool)').item.json.data.matched }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "ai-cond-005",
              "leftValue": "={{ $('RelayShield - MCP Registry Risk (AI Tool)').item.json.data.verdict }}",
              "rightValue": "CRITICAL",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ai-cond-006",
              "leftValue": "={{ $('RelayShield - MCP Registry Risk (AI Tool)').item.json.data.verdict }}",
              "rightValue": "HIGH",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "c4d5e6f7-0011-0011-0011-000000000011",
      "name": "Any AI-Tool Risk Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        840,
        360
      ],
      "notes": "Same as the SaaS decision, plus a CRITICAL/HIGH mcp-registry-risk verdict — the added AI-tool-specific signal."
    },
