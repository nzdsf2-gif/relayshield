+
+    if kind == "message":
+        # Shape only. Never the text itself.
+        parts.append("has_text=%s" % bool(payload.get("text")))
+        parts.append("has_photo=%s" % bool(payload.get("photo")))
+        if payload.get("text", "").startswith("/"):
