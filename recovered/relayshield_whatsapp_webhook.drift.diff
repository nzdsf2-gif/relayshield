+def msg_simswap_consent() -> str:
+    """The consent prompt. Carrier wording is quoted verbatim from the shared
+    module so all four surfaces show identical text and it cannot drift."""
+    return (
+        "*One last thing: SIM swap monitoring*\n\n"
+        "A SIM swap lets an attacker receive your SMS one-time passcodes, which is "
+        "how most account takeovers start. We can watch this number for SIM and "
+        "carrier changes and alert you.\n\n"
+        "To do that we need your permission:\n\n"
+        f"_{simswap_consent.CARRIER_CONSENT_TEXT}_\n\n"
+        "Full terms: https://terms.relayshield.net\n\n"
+        "Reply *YES* to turn it on, or *NO* to skip. You can change your mind "
+        "any time by replying STOPSIM."
+    )
+
+
+def handle_awaiting_simswap_consent(
+    user: dict,
+    message_body: str,
+    twilio_creds: tuple,
+) -> str:
+    """YES/NO consent for SIM swap monitoring.
+
+    The number enrolled is the one this WhatsApp message arrived FROM, which is
+    the strongest consent provenance available: the person is replying from the
+    handset whose carrier we would query. That is a self enrollment by any
+    reasonable reading, and it is what the carrier clause means by "you".
+    """
+    account_sid, auth_token, from_number = twilio_creds
+    user_id   = user["user_id"]
+    to_number = get_user_whatsapp_number(user)
+    body      = message_body.strip().upper()
+
+    if body not in ("YES", "NO"):
+        send_whatsapp(
+            to_number,
+            "Please reply *YES* to enable SIM swap monitoring, or *NO* to skip it.",
+            account_sid, auth_token, from_number,
+        )
+        return "invalid_response"
+
+    if body == "NO":
+        update_user(user_id, {
+            "onboarding_state":    STATE_ACTIVE,
+            "sim_swap_monitoring": False,
+            "consent_state":       "DECLINED",
+        })
+        send_whatsapp(
+            to_number,
+            "No problem, SIM swap monitoring is off. Everything else is active.\n\n"
+            "Reply SIMSWAP at any time if you change your mind.",
+            account_sid, auth_token, from_number,
+        )
+        return "simswap_declined"
+
+    phone = simswap_consent.normalise_e164(to_number)
+    try:
+        # Consent belongs to the NUMBER, session state belongs to THIS record,
+        # and they are not always the same row. Found 2026-08-14 during the
+        # Twilio evidence capture: this used to pass onboarding_state through
+        # enroll(), which applies attributes to whichever record the phone_hash
+        # lookup returns. The founder's number is on two records, so the state
+        # advanced on the enrolled one while his WhatsApp session stayed in
+        # AWAITING_SIMSWAP_CONSENT and the next command fell through to the
+        # YES/NO branch. Update the session record explicitly instead.
+        simswap_consent.enroll(
+            phone,
+            enrollment_type="self",
+            consent_source="whatsapp",
+            consent_acknowledged=True,
+        )
+        update_user(user_id, {"onboarding_state": STATE_ACTIVE})
+    except Exception as exc:
+        logger.error("whatsapp simswap consent enrollment failed user=%s: %s", user_id, exc)
+        update_user(user_id, {"onboarding_state": STATE_ACTIVE})
+        # Never claim protection that was not switched on.
+        send_whatsapp(
+            to_number,
+            "⚠️ We couldn't switch SIM swap monitoring on just now, and we won't tell "
+            "you it's active when it isn't. Our team has been alerted. Everything else "
+            "is working. Reply SIMSWAP to try again.",
+            account_sid, auth_token, from_number,
+        )
+        return "simswap_enroll_failed"
+
+    send_whatsapp(
+        to_number,
+        "✅ SIM swap monitoring is on for this number.\n\n"
+        "We'll alert you if your SIM or carrier changes unexpectedly. "
+        "Reply STOPSIM at any time to turn it off.",
+        account_sid, auth_token, from_number,
+    )
+    logger.info("simswap consent granted — user_id=%s phone=%s",
+                user_id, simswap_consent.redact(phone))
+    return "simswap_enrolled"
 
 
