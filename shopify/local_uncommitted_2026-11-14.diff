 /* router                                                              */
 /* ------------------------------------------------------------------ */
 
+
+/* --- RelayShield Shopify App Pricing billing, added 2026-11-03 --- */
+/* App Pricing enabled: Shopify hosts plan selection, this code only */
+/* reads the active subscription and gates screening limits by it. */
+/* No appSubscriptionCreate, no Stripe, no external checkout. */
+const BILLING_API_VERSION = "2026-07";
+const FREE_SCREENING_LIMIT = 100;
+const PAID_SCREENING_LIMIT = 2000;
+const PAID_PRICE_USD = 29;
+const PAID_PLAN_NAME = "Paid";
+function billingMonthKey(d) {
+  const dt = d || new Date();
+  return dt.getUTCFullYear() + "-" + String(dt.getUTCMonth() + 1).padStart(2, "0");
+}
+function billingCountKey(shop, month) { return "screenings-count:" + shop + ":" + month; }
+async function getMonthlyCount(env, shop) {
+  try {
+    const raw = await env.RS_KV.get(billingCountKey(shop, billingMonthKey()));
+    const n = raw ? JSON.parse(raw).count : 0;
+    return typeof n === "number" ? n : 0;
+  } catch { return 0; }
+}
+async function incrementMonthlyCount(env, shop) {
+  const month = billingMonthKey();
+  const key = billingCountKey(shop, month);
+  try {
+    const raw = await env.RS_KV.get(key);
+    const cur = raw ? JSON.parse(raw).count : 0;
+    const next = (typeof cur === "number" ? cur : 0) + 1;
+    await env.RS_KV.put(key, JSON.stringify({ month, count: next }));
+    return next;
+  } catch { return 0; }
+}
+async function billingGraphql(shop, token, query) {
+  const resp = await fetch("https://" + shop + "/admin/api/" + BILLING_API_VERSION + "/graphql.json", {
+    method: "POST",
+    headers: { "X-Shopify-Access-Token": token, "Content-Type": "application/json" },
+    body: JSON.stringify({ query }),
+  });
+  const data = await resp.json().catch(() => ({}));
+  if (!resp.ok || (data.errors && data.errors.length)) {
+    throw new Error("Shopify GraphQL billing check failed: " + resp.status);
+  }
+  return data.data;
+}
+async function getActiveSubscription(shop, token) {
+  const data = await billingGraphql(shop, token, `query {
+    currentAppInstallation {
+      activeSubscriptions {
+        id name status
+        lineItems { plan { pricingDetails {
+          ... on AppRecurringPricing { price { amount currencyCode } interval }
+        } } }
+      }
+    }
+  }`);
+  const subs = (data && data.currentAppInstallation && data.currentAppInstallation.activeSubscriptions) || [];
+  for (const sub of subs) {
+    if (sub.status !== "ACTIVE") continue;
+    if (sub.name === PAID_PLAN_NAME) {
+      const firstItem = (sub.lineItems || [])[0];
+      const price = firstItem && firstItem.plan && firstItem.plan.pricingDetails && firstItem.plan.pricingDetails.price;
+      return { isPaid: true, name: sub.name, amount: price ? Number(price.amount) : 0, status: sub.status, subscriptionId: sub.id };
+    }
+  }
+  return { isPaid: false, name: "Free", amount: 0, status: "FREE", subscriptionId: null };
+}
+function getShopPlan(active, monthlyCount) {
+  const limit = active.isPaid ? PAID_SCREENING_LIMIT : FREE_SCREENING_LIMIT;
+  return {
+    plan: active.isPaid ? PAID_PLAN_NAME : "Free",
+    isPaid: active.isPaid,
+    limit,
+    used: monthlyCount,
+    remaining: Math.max(0, limit - monthlyCount),
+    overLimit: monthlyCount >= limit,
+    subscriptionId: active.subscriptionId,
+  };
+}
+/* Gate helper: call this at the top of handleOrdersCreate, after token */
+/* refresh, before screening. If allowed is false, return early with no */
+/* tag and no note, and let the dashboard show the over-limit message. */
+/* On a billing API error, this fails open to free limits, never paid, */
+/* so a billing outage never grants paid screening by mistake. */
+async function checkScreeningAllowed(env, shop, token) {
+  let active;
+  try { active = await getActiveSubscription(shop, token); }
+  catch (e) { console.log("billing check failed, using free limits: " + e.message); active = { isPaid: false, name: "Free", amount: 0, status: "FREE", subscriptionId: null }; }
+  const used = await getMonthlyCount(env, shop);
+  const plan = getShopPlan(active, used);
+  return { allowed: !plan.overLimit, plan };
+}
+async function handleBillingStatus(request, env) {
+  const url = new URL(request.url);
+  const auth = request.headers.get("Authorization") || "";
+  const bearer = auth.startsWith("Bearer ") ? auth.slice(7) : url.searchParams.get("id_token") || "";
+  const shop = await verifySessionToken(env, bearer);
+  if (!shop) return new Response("Unauthorized", { status: 401 });
+  try {
+    const token = await getFreshAccessToken(env, shop);
+    const active = await getActiveSubscription(shop, token);
+    const used = await getMonthlyCount(env, shop);
+    const plan = getShopPlan(active, used);
+    return new Response(JSON.stringify(plan), { headers: { "Content-Type": "application/json" } });
+  } catch (e) {
+    return new Response(JSON.stringify({ plan: "Free", isPaid: false, limit: FREE_SCREENING_LIMIT, used: await getMonthlyCount(env, shop), remaining: null, overLimit: false, billingUnknown: true }), { headers: { "Content-Type": "application/json" } });
+  }
+}
+async function handleAppSubscriptionsUpdate(request, env) {
+  const raw = await request.text();
+  const hmac = request.headers.get("X-Shopify-Hmac-Sha256") || "";
+  if (!(await verifyShopifyHmac(env.SHOPIFY_API_SECRET, raw, hmac))) {
+    return new Response("Unauthorized", { status: 401 });
+  }
+  let payload = {};
+  try { payload = JSON.parse(raw); } catch { payload = {}; }
+  const shop = (payload && (payload.shop_domain || payload.shop)) || "";
+  const status = payload && payload.app_subscription ? payload.app_subscription.status : "";
+  if (shop && (status === "CANCELLED" || status === "EXPIRED" || status === "FROZEN")) {
+    try {
+      const rec = (await kvGet(env, shopKey(shop))) || {};
+      rec.plan = "Free";
+      rec.subscriptionId = null;
+      await kvPut(env, shopKey(shop), rec);
+    } catch {}
+  }
+  return new Response("ok");
+}
+function renderPlanCard(plan) {
+  return '<div class="card"><div class="n">' + plan.used + ' / ' + plan.limit + '</div><div>Screenings this month, plan ' + plan.plan + '</div><p class="note">Upgrade in Shopify: in Shopify admin, Apps, RelayShield Order Screening, select the Paid plan. No external checkout.</p></div>';
+}
+/* --- end billing, added 2026-11-03 --- */
+
